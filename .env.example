# Local development environment for Docker
PROJECT_NAME="Veriphy API"
VERSION="1.0.0"
ENVIRONMENT="local"
DATABASE_URL="postgresql+asyncpg://user:password@host:port/veriphy"
REDIS_URL="redis://redis:6379/0"
JWT_SECRET_KEY="development-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS='["*"]'
AWS_REGION=""
AWS_KMS_KEY_ID=""
BVN_HASH_PEPPER="development-bvn-pepper"
SQUAD_API_URL="https://sandbox-api-d.squadco.com"
SQUAD_SECRET_KEY="development-squad-secret"
SMS_HMAC_SECRET="development-sms-secret"
LOCAL_DEK="development-local-dek-0000000000000000000000"
GOOGLE_PLAY_INTEGRITY_API_KEY=""
